[
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:0", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:1"], "en": "The seed-mantra of Ketu is: Oṃ srāṃ srīṃ srauṃ saḥ, obeisance to Ketu.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:2"], "en": "Oṃ, homage to Ketu.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:3"], "en": "Oṃ, salutation to Sthūlaśiras.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:4"], "en": "Oṃ, homage to the mere head.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:5"], "en": "Oṃ, homage to the one whose form is a banner.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:6"], "en": "Oṃ, homage to the one joined with the nine planets.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:7"], "en": "Oṃ, salutation to the one born from the womb of the asura Siṃhikā.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:8"], "en": "Oṃ, homage to the one who causes great terror!", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:9"], "en": "Oṃ, homage to the one of variegated color.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:10"], "en": "Oṃ, homage to the illustrious Piṅgalākṣaka.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:11", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:12"], "en": "Oṃ, salutation to the one who resembles a full-blown smoky-red lotus. 10 Oṃ, salutation to the one with sharp fangs.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:18Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:13"], "en": "Oṃ, homage to Mahodara.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:14"], "en": "Oṃ, homage to the one with red eyes.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:15"], "en": "Oṃ, homage to Citrakārin!", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:16"], "en": "Oṃ, homage to Tīvrakopa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:17"], "en": "Oṃ, homage to the Great Asura.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:18"], "en": "Oṃ, homage to Krūrakaṇṭha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:19"], "en": "Oṃ, homage to Krodhanidhi.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:20"], "en": "Oṃ, homage to the specific deity Chāyāgraha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:21", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:22"], "en": "Oṃ, obeisance to Antyagraha. Oṃ, obeisance to Mahāśīrṣa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:23"], "en": "Oṃ, homage to Sūryāra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:24"], "en": "Oṃ, homage to the one who grasps like a flower.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:25"], "en": "Oṃ, homage to Varahasta.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:26"], "en": "Oṃ, homage to the one who holds a mace in his hand.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:27"], "en": "Oṃ, homage to the one who wears variegated garments.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:28"], "en": "Oṃ, homage to the one with the variegated banner and flag!", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:29"], "en": "Oṃ, homage to the Terrible One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:30"], "en": "Oṃ, homage to Citraratha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:31"], "en": "Oṃ, homage to Śikhin.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:32"], "en": "Oṃ, homage to the eater of horse-gram.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:33"], "en": "Oṃ, homage to the one adorned with beryl ornaments.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:34"], "en": "Oṃ, homage to the one who produces portents.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:35"], "en": "Oṃ, homage to Śukramitra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:36"], "en": "Oṃ, homage to Mandasakhāya.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:37"], "en": "Oṃ, homage to Gadādhara.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:38"], "en": "Oṃ, salutation to the Lord of Heaven.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:39"], "en": "Oṃ, homage to Antarvedīśvara.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:40"], "en": "Oṃ, salutation to the one born of the Jaimini lineage.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:41", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:42"], "en": "Oṃ, obeisance to Citraguptātman. Oṃ, obeisance to the one facing south.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:43"], "en": "Oṃ, homage to Mukunda, the recipient of the boon.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:44"], "en": "Oṃ, homage to the one born from the great lineage of asuras.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:45"], "en": "Oṃ, homage to the one of cloud-like color.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:46"], "en": "Oṃ, homage to Lambadeva.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:47"], "en": "Oṃ, homage to the Son of Death.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:48"], "en": "Oṃ, homage to the one who assumes the form of a portent!", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:49"], "en": "Oṃ, homage to the invisible one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:50"], "en": "Oṃ, homage to the one resembling the fire of cosmic destruction.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:51", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:52"], "en": "Oṃ, obeisance to Nṛpīḍa. 50. Oṃ, obeisance to Grahakārin.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:53"], "en": "Oṃ, homage to the one who causes all calamities!", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:54"], "en": "Oṃ, homage to the one from whom manifold things are born.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:55"], "en": "Oṃ, homage to Analā.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:56"], "en": "Oṃ, homage to the destroyer of all diseases.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:57"], "en": "Oṃ, homage to the one who moves counter-clockwise.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:58"], "en": "Oṃ, homage to the one who bestows evil upon the ninth.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:59"], "en": "Oṃ, salutation to the fifth [deity], the giver of sorrow.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:60"], "en": "Oṃ, homage to the sky-walker during an eclipse.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:61", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:62"], "en": "Oṃ, salutation to the one whose action is supreme. 60 Oṃ, salutation to the giver of happiness in the fourth state (turiya).", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:63"], "en": "Oṃ, salutation to the third [deity], the giver of enmity.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:64"], "en": "Oṃ, homage to the evil planet.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:65"], "en": "Oṃ, homage to the one who causes bursting.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:66"], "en": "Oṃ, homage to the Lord of Life.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:67"], "en": "Oṃ, homage to the one who causes weariness in the fifth [stage].", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:68"], "en": "Oṃ, salutation to the giver of indistinct speech in the second [period].", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:69"], "en": "Oṃ, homage to the one whose face and body are distressed by poison.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:70"], "en": "Oṃ, homage to the one who can assume any form at will.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:71"], "en": "Oṃ, homage to Siṃhadanta.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:72"], "en": "Oṃ, homage to Kuśedhmapriya.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
