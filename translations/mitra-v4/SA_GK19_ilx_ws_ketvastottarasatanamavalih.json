{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:79"], "en": "Oṃ, homage to the one arisen from the mass of karma.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:80"], "en": "Oṃ, salutation to Upānta, the giver of fame.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
