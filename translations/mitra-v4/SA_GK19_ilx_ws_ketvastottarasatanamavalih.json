{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:97"], "en": "Oṃ, homage to the one who is affectionate toward his devotees.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:98"], "en": "Oṃ, homage to the lion throne.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:99"], "en": "Oṃ, salutation to Ketumūrti.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:100"], "en": "Oṃ, homage to the one who destroys the splendor of the sun and moon.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:101", "SA_GK19_ilx_ws_ketvastottarasatanamavalih:102"], "en": "Oṃ, obeisance to Amarā. 100. Oṃ, obeisance to Pīḍaka.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
