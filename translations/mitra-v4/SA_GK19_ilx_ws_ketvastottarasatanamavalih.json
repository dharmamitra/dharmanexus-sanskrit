{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:83"], "en": "Oṃ, homage to Dhana, the bestower of much happiness.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:84"], "en": "Oṃ, salutation to Jananā, the giver of disease.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:85"], "en": "Oṃ, homage to the one with hair standing upright.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:86"], "en": "Oṃ, homage to the leader of the planets.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:87"], "en": "Oṃ, homage to Pāpadṛṣṭi.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:88"], "en": "Oṃ, homage to the Sky-walker (Khecarāya).", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:19Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:89"], "en": "Oṃ, salutation to Śambhu.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:90"], "en": "Oṃ, homage to the one worshipped by all without exception.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:91"], "en": "Oṃ, homage to the Eternal One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
{"segs": ["SA_GK19_ilx_ws_ketvastottarasatanamavalih:92"], "en": "Oṃ, homage to the Dancer.", "model": "mitra-v4", "translated_at": "2026-11-25T05:46:20Z"},
