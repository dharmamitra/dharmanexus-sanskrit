[
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:0", "SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:1"], "en": "Having bowed with devotion to the Buddhas together with their Sons, and having honored them according to one's ability, [I shall explain] that morality of the Bodhisattvas which exists in all directions and at all times. (1)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:2", "SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:3"], "en": "With the highest intention, that treasury of all merits should be received from a learned and capable teacher who abides in the vows. (2)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:4"], "en": "Then, at all times, they are constantly attended by the Victors together with their sons;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:5"], "en": "for the sake of their welfare alone, with virtuous minds, as if toward a beloved son. (3)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:6"], "en": "One should act for the benefit and happiness [of others], or even for their suffering if it is indeed beneficial;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:7"], "en": "but one should never do that which is harmful, whether it brings happiness to oneself or to others.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:8", "SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:9"], "en": "For him, there are four offenses considered equivalent to the *pārājika* rules—those which cause the loss of the vow due to the arising of intense afflictions. (5)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:10", "SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:11"], "en": "For one greedy for gain and honor, who exalts himself and disparages others, there is the failure to give wealth or the Dharma out of stinginess to those who are suffering and without a protector. (6)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:12", "SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:13"], "en": "Striking another out of anger, refusing to accept a conciliatory gesture from another, rejecting the Mahāyāna, and proclaiming a counterfeit of the true Dharma. ||7||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:14"], "en": "Furthermore, restraint is to be undertaken; the intermediate outflows are to be confessed before three [persons];", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:15"], "en": "and the remaining [outflows], whether afflicted or non-afflicted, may be confessed before even one person, according to one's own mind. (8)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:16"], "en": "... threefold worship toward the Three Jewels ...", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:17"], "en": "||9||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:18"], "en": "One does not fail to make offerings to the Three Jewels in three ways.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:19", "SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:20"], "en": "They follow after a mind of desire and show no respect for their elders.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:21"], "en": "One does not provide an answer to what is asked.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:22"], "en": "One does not take guests as one's own.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:23"], "en": "One does not accept gold and other such things.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:24"], "en": "One does not give the Dharma to those who desire it.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:25"], "en": "They cast aside those who have lapsed in ethical discipline. ||10||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:26"], "en": "...", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:27"], "en": "for one who is compassionate, there is no unwholesomeness.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:28"], "en": "||11|| One does not train for the sake of others.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:29"], "en": "Little benefit is brought to the welfare of sentient beings.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:30"], "en": "If one possesses compassion, there is no non-virtue.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:31"], "en": "Accepting wrong livelihood. ||11||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:32"], "en": "Having tossed [the head] about, one becomes excessively agitated and so forth.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:33"], "en": "One thinks only of traversing saṃsāra alone.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:34"], "en": "Not abandoning ill repute.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:35"], "en": "Even though afflicted by mental afflictions, one does not practice the Dharma. ||12||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:36"], "en": "To strike back at one who strikes, and so forth.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:37"], "en": "Those who are angry neglect their duties;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:38"], "en": "they abandon repentance toward others.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:39"], "en": "One follows after a mind of anger. ||13||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:40"], "en": "Out of a desire for honor, they gather a retinue.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:41"], "en": "It does not eliminate the letter *la* and so forth.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:42"], "en": "Out of attachment, he relied upon the words of a woman.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:43"], "en": "They do not seek the meaning of meditative concentration. ||14||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:44"], "en": "They do not abandon the obscurations to meditative concentration.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:45"], "en": "One views the qualities in the taste of meditative concentration.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:46"], "en": "One abandons the vehicle of the śrāvakas.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:47"], "en": "While possessing one's own disposition, one applies oneself to that. 15.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:48"], "en": "Lacking diligence, they apply themselves to external treatises.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:49"], "en": "Even though one exerts oneself, one finds no joy in that.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:50"], "en": "One abandons the Mahāyāna.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:51"], "en": "Praising oneself and disparaging others. ||16||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:52"], "en": "One does not go for the sake of the Dharma.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:53"], "en": "They revile him and rely upon the written word.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:54"], "en": "One does not act as a necessary companion.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:55"], "en": "One abandons the performance of medical treatments for the sick. //17//", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:56"], "en": "That which does not eliminate suffering.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:57"], "en": "One does not reveal the lineage to those who lack faith.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:58"], "en": "One does not repay kindness with kindness.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:59"], "en": "One does not perform the purification of others' grief. ||18||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:60"], "en": "Nor does one give to those who do not desire it.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:61"], "en": "It does not accomplish the welfare of those in one's retinue.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:62"], "en": "One does not act in accordance with the minds of others.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:63"], "en": "One should not speak in praise of one's own virtues. (19)", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:64"], "en": "...", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:65"], "en": "there is no offense for one whose mind is virtuous, out of affection and compassion. ||20||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:66"], "en": "One does not suppress [the opponent] in a manner that is disproportionate to the circumstances.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:67"], "en": "One should not employ miraculous powers for sinful purposes and the like.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:68"], "en": "Because they possess compassion and because they are loving,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Candragomin_Bodhisattvasaṃvaraviṃśikā-Skt-verses-available-in-testimonia-thus-far_Li_2015:69"], "en": "There is no fault in a virtuous mind. ||20||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"}
]
