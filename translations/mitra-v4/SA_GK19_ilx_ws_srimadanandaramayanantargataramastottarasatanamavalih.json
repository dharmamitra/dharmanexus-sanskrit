[
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:0"], "en": "The List of One Hundred and Eight Names of Śrī Rāma from the Illustrious Ānanda-Rāmāyaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:1"], "en": "Meditative absorption.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:2", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:3", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:4"], "en": "I salute the joy of the Raghus, the lord of the gods, whose form is like a *mandāra* flower, who is an abode of merit, whose soft chest is radiant, who is peaceful, whose thousand faces possess the beautiful luster of lovely sapphires, and who is the preceptor of the initiation into archery.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:5"], "en": "To Rāma, whose feet are well-served by the entire world and who is the beloved of Sītā’s heart.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:6", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:7", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:8"], "en": "Oṃ, homage to the thousand-headed one. Oṃ, homage to the thousand-eyed one. Oṃ, homage to the thousand-handed one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:9", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:10", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:11"], "en": "Oṃ, salutation to the one with a thousand feet. Oṃ, salutation to the one with the color of a cloud. Oṃ, salutation to the one whose face is on all sides.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:12", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:13"], "en": "Oṃ, homage to Acyuta. Oṃ, homage to Śeṣaśāyin.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:14"], "en": "Oṃ, homage to Hiraṇyagarbha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:15", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:16"], "en": "Oṃ, obeisance to the self of the five elements. 10 Oṃ, obeisance to the primordial nature (mūlaprakṛti).", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:17"], "en": "Oṃ, obeisance to the benefactor of the gods.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:18", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:19"], "en": "Oṃ, homage to the Lord of all worlds! Oṃ, homage to the destroyer of all suffering!", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:20"], "en": "Oṃ, homage to the one who bears the conch, the discus, the mace, the lotus, the matted locks, and the crown!", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:21"], "en": "Oṃ, homage to the Embryo.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:22"], "en": "Oṃ, homage to Reality.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:23"], "en": "Oṃ, homage to the Light of lights.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:24"], "en": "Oṃ, obeisance to Vāsudeva.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:25", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:26"], "en": "Oṃ, obeisance to the son of Daśaratha. 20. Oṃ, obeisance to the lord of kings.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:27", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:28", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:29"], "en": "Oṃ, salutations to the bestower of all prosperity. Oṃ, salutations to the embodiment of compassion. Oṃ, salutations to the one who acts for the pleasure of Kaikeyī.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:30", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:31"], "en": "Oṃ, homage to the Tamed One. Oṃ, homage to the Peaceful One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:32"], "en": "Oṃ, homage to the Beloved of Viśvāmitra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:33", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:34"], "en": "Oṃ, obeisance to Ya-eśa. Oṃ, obeisance to Kratupālaka.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:35"], "en": "Oṃ, obeisance to Keśava. 30.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:36"], "en": "Oṃ, homage to the Protector.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:37"], "en": "Oṃ, homage to the wielder of the Śārṅga bow.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:38"], "en": "Oṃ, homage to Rāmacandra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:39"], "en": "Oṃ, homage to Nārāyaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:40"], "en": "Oṃ, homage to Rāmacandra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:41"], "en": "Oṃ, homage to Mādhava.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:42", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:43", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:44"], "en": "Oṃ, obeisance to Govinda. Oṃ, obeisance to the Supreme Self. Oṃ, obeisance to the one whose nature is Viṣṇu.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:45", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:46"], "en": "Oṃ, salutations to Raghunātha. 40 Oṃ, salutations to Nāthanātha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:47"], "en": "Oṃ, salutations to Madhusūdana.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:48", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:49", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:50"], "en": "Oṃ, obeisance to Trivikrama. Oṃ, obeisance to the Lord of Sītā. Oṃ, obeisance to Vāmana.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:05Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:51", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:52"], "en": "Oṃ, salutation to Rāghava. Oṃ, salutation to Śrīdhara.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:53"], "en": "Oṃ, salutation to Jānakīvallabha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:54", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:55"], "en": "Oṃ, obeisance to Hṛṣīkeśa. Oṃ, obeisance to Kandarpa. 50.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:56"], "en": "Oṃ, obeisance to Padmanābha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:57", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:58"], "en": "Oṃ, salutation to the one who causes joy to Kauśalyā; Oṃ, salutation to the lotus-eyed one;", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:59"], "en": "Oṃ, salutation to the elder brother of Lakṣmaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:60"], "en": "Oṃ, obeisance to the descendant of Kakutstha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:61", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:62"], "en": "Oṃ, obeisance to Dāmodara. Oṃ, obeisance to the protector of Vibhīṣaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:63"], "en": "Oṃ, salutation to Saṅkarṣaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:64"], "en": "Oṃ, salutation to Vāsudeva.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:65"], "en": "Oṃ, salutation to the beloved of Śaṅkara. 60.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:66"], "en": "Oṃ, homage to Pradyumna.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:67", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:68"], "en": "Oṃ, homage to Aniruddha. Oṃ, homage to the one whose form is devotion to both the existent and the non-existent.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:69", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:70", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:71"], "en": "Oṃ, homage to Puruṣottama. Oṃ, homage to Adhokṣaja. Oṃ, homage to Saptatālahara.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:72", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:73", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:74"], "en": "Oṃ, salutation to the destroyer of Kharadūṣaṇa. Oṃ, salutation to Śrī Nṛsiṃha. Oṃ, salutation to Acyuta.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:75"], "en": "Oṃ, salutation to Setubandhaka. 70.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:76", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:77"], "en": "Oṃ, salutation to Janārdana. Oṃ, salutation to Hanumadāśraya.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:78", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:79"], "en": "Oṃ, homage to the one worthy of worship by Upendra and Candra. Oṃ, homage to the destroyer of Mārīca.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:80"], "en": "Oṃ, homage to the one who struck down Vālin.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:81", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:82"], "en": "Oṃ, homage to the one who bestows the kingdom upon Sugrīva. Oṃ, homage to the one who removes the great pride of Paraśurāma, the son of Jamadagni.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:83"], "en": "Oṃ, homage to Hari.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:84", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:85"], "en": "Oṃ, obeisance to Kṛṣṇa. Oṃ, obeisance to the elder brother of Bharata. 80.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:86"], "en": "Oṃ, obeisance to the one devoted to his father.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:87"], "en": "Oṃ, salutation to the elder brother of Śatrughna.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:88"], "en": "Oṃ, salutation to the lord of Ayodhyā.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:89"], "en": "Oṃ, salutation to the one served by Śatrughna.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:90"], "en": "Oṃ, homage to the Eternal One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:91", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:92"], "en": "Oṃ, homage to the Truthful One. Oṃ, homage to the one whose form consists of the intellect and so forth.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:93", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:94"], "en": "Oṃ, salutation to the one whose nature is non-dual Brahman. Oṃ, salutation to the one who is unapproachable.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:95"], "en": "Oṃ, salutation to the Perfect One. 90", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:96"], "en": "Oṃ, salutation to the Delightful One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:97", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:98"], "en": "Oṃ, salutation to Mādhava. Oṃ, salutation to the Self of Consciousness.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:99"], "en": "Oṃ, salutation to the Lord of Ayodhyā.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:100", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:101"], "en": "Oṃ, salutation to the Most Excellent One. Oṃ, salutation to Pure Consciousness alone.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:102"], "en": "Oṃ, salutation to the Supreme Self.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:103", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:104"], "en": "Oṃ, salutation to the deliverer of Ahalyā. Oṃ, salutation to the breaker of the bow.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:105", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:106", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:107"], "en": "Oṃ, obeisance to Sītārāma. 100 Oṃ, obeisance to the one worthy of service. Oṃ, obeisance to the one worthy of praise.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
{"segs": ["SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:108", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:109", "SA_GK19_ilx_ws_srimadanandaramayanantargataramastottarasatanamavalih:110"], "en": "Oṃ, homage to Parameṣṭhin. Oṃ, homage to the one with arrows in hand. Oṃ, homage to the wielder of the bow.", "model": "mitra-v4", "translated_at": "2026-11-25T05:54:06Z"},
