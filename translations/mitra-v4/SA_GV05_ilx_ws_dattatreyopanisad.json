[
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:0"], "en": "The Dattātreya Upaniṣad", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:1"], "en": "We worship Dattātreya, whose form is the bliss perceivable through the Brahma-vidyā of Dattātreyī,", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:2"], "en": "and who is the source of the three-footed Nārāyaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:3"], "en": "Oṃ! O Gods, may we hear with our ears what is auspicious; O Holy Ones, may we see with our eyes what is auspicious.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:4"], "en": "With steady limbs and bodies, may we, praising you, attain that lifespan ordained by the gods.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:5"], "en": "May Indra of far-reaching fame grant us well-being; may Pūṣan, the all-knowing, grant us well-being.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:6"], "en": "May Tārkṣya with his uninjured wheel grant us well-being; may Bṛhaspati bestow well-being upon us.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:7"], "en": "Oṃ, peace, peace, peace.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:8", "SA_GV05_ilx_ws_dattatreyopanisad:9", "SA_GV05_ilx_ws_dattatreyopanisad:10"], "en": "Hari Oṃ! In the field of truth (Satyakṣetra), Brahmā asked Nārāyaṇa: \"O Blessed One, what is that Great Sovereignty which is the Savior? Tell us that. Being thus addressed, [Nārāyaṇa] said: \"Worship my abode, which is Truth, Bliss, and of the nature of Sattva.\"", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:11", "SA_GV05_ilx_ws_dattatreyopanisad:12", "SA_GV05_ilx_ws_dattatreyopanisad:13"], "en": "They say, \"I am always given,\" by which they become transmigratory beings; thus addressed by Nārāyaṇa, Brahmā meditated upon Viṣṇu Nārāyaṇa, who bears the universal form as Dattātreya, and spoke these true words.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:14", "SA_GV05_ilx_ws_dattatreyopanisad:15"], "en": "*Dām* is *haṃsa*. *Dā* is its long seed-syllable (*bīja*), which resides within the name.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:16"], "en": "Thus, *dām* becomes a single syllable.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:17"], "en": "This is the Savior;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:18"], "en": "it alone is to be worshipped and known as that which delivers one from the womb and other [sufferings].", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:19"], "en": "Its meter is Gāyatrī.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:20"], "en": "Sadāśiva is the seer;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:21"], "en": "Dattātreya is the deity;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:22"], "en": "[it is] like [the sprout] residing within a banyan seed.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:23"], "en": "The entire world resides within the seed that has been bestowed.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:24"], "en": "This very [seed] has been explained;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:25"], "en": "I shall now explain it further.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:26"], "en": "The six-syllable mantra:", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:27"], "en": "\"Oṃ\" is the second;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:28"], "en": "\"Hrīḥ\" is the third.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:29"], "en": "*Klīm* is the fourth;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:30"], "en": "*glauṃ* is the fifth;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:31"], "en": "*drām* is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:32", "SA_GV05_ilx_ws_dattatreyopanisad:33"], "en": "This consists of six syllables; it is the experience of yoga;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:34"], "en": "the meter is Gāyatrī.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:35"], "en": "Sadāśiva is the seer;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:36", "SA_GV05_ilx_ws_dattatreyopanisad:37"], "en": "Dattātreya is the deity.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:38"], "en": "Having uttered \"Dram\" or having uttered \"Drām,\" [one recites] the eight-syllable mantra: \"Dattātreyāya namaḥ.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:39"], "en": "In this, \"Dattātreyāya\" refers to the essence of truth, bliss, and consciousness;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:40"], "en": "\"namaḥ\" refers to the embodiment of perfect bliss.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:41"], "en": "The meter is Gāyatrī;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:42"], "en": "Sadāśiva is the seer;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:43"], "en": "Dattātreya is the deity.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:44", "SA_GV05_ilx_ws_dattatreyopanisad:45"], "en": "\"To Dattātreya\" is the *kīlaka*;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:46"], "en": "that same [mantra] is the seed-syllable (*bīja*).", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:47"], "en": "The power (śakti) is \"namaḥ.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:48", "SA_GV05_ilx_ws_dattatreyopanisad:49"], "en": "First is \"oṃ,\" then \"āṃ.\"", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:50", "SA_GV05_ilx_ws_dattatreyopanisad:51"], "en": "The second is *hrīṃ*; the third is *hrīṃ*;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:52"], "en": "the fourth is *kroṃ*.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:53"], "en": "One should say \"Ehi\" (Come) at that very moment.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:54"], "en": "\"Dattātreyāya svāhā\"—this twelve-syllable mantra is the king of mantras;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:55"], "en": "its meter is Jagatī.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:56"], "en": "Sadāśiva is the seer (ṛṣi);", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:57"], "en": "Dattātreya is the deity (devatā);", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:58"], "en": "\"Om\" is the seed-syllable (bīja).", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:59"], "en": "\"svāhā\" is the power (śakti);", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:60"], "en": "\"saṃbuddhiḥ\" is the pin (kīlaka);", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:61"], "en": "\"dram\" is in the heart.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:62"], "en": "*Hrīṃ klīm* at the head;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:63"], "en": "*ehi* at the crest-lock;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:64"], "en": "*datta* at the armor.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:65"], "en": "\"Ātreya\" for the eyes;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:66"], "en": "\"Svāhā\" for the weapon.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:67"], "en": "One becomes composed of that.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:68"], "en": "He who knows thus:", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:69"], "en": "I shall explain the sixteen-syllable [mantra].", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:70"], "en": "Life-breath is to be given.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:71"], "en": "Pride should be given away;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:72", "SA_GV05_ilx_ws_dattatreyopanisad:73"], "en": "the eye should be given away; the ear should be given away.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:74"], "en": "One who severs the sixteen heads [of the enemy] by means of the sixteen-syllable mantra must not bestow it;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:75"], "en": "one should speak it only to a disciple who is devoted to supreme service and possesses virtuous qualities.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:76"], "en": "\"Oṃ\" is the first [syllable].", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:77"], "en": "*Aim* is the second;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:78"], "en": "*krom* is the third;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:79"], "en": "*klīm* is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:80"], "en": "*Klūm* is the fifth;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:81", "SA_GV05_ilx_ws_dattatreyopanisad:82"], "en": "*hrām* is the sixth; *hrīm* is the [seventh].", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:83", "SA_GV05_ilx_ws_dattatreyopanisad:84"], "en": "The seventh is *hrūṃ*; the eighth is *saḥ*;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:85"], "en": "the ninth is *sauri*.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:86"], "en": "The fourteenth is \"to Dattātreya\";", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:87", "SA_GV05_ilx_ws_dattatreyopanisad:88"], "en": "the sixteenth is \"svāhā. The meter is Gāyatrī.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:89"], "en": "Sadāśiva is the seer (ṛṣi);", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:90"], "en": "Dattātreya is the deity;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:91"], "en": "Oṃ is the seed-syllable (bīja).", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:92", "SA_GV05_ilx_ws_dattatreyopanisad:93"], "en": "Svāhā is the power (śakti). That which ends in the dative case is the pin (kīlaka).", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:94"], "en": "\"Oṃ\" is in the heart.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:95"], "en": "*klāṃ klīṃ klūm* at the crest-lock;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:96", "SA_GV05_ilx_ws_dattatreyopanisad:97"], "en": "*sauḥ* at the armor.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:98"], "en": "The word ending in the dative case is for the eyes;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:99"], "en": "\"svāhā\" is for the weapon (astra).", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:100"], "en": "He who...", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:101", "SA_GV05_ilx_ws_dattatreyopanisad:102", "SA_GV05_ilx_ws_dattatreyopanisad:103"], "en": "One who studies this constantly becomes happy through *saccidānanda* and attains liberation; at the end, he is called a *śauri*, that is, a *śrīvaiṣṇava*. One who mutters this mantra becomes the very form of Viṣṇu.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:104"], "en": "It occurs.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:105"], "en": "I shall explain the *anuṣṭubh* meter;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:106"], "en": "[this applies] everywhere.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:107"], "en": "These are called the Sambuddhis:", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:108", "SA_GV05_ilx_ws_dattatreyopanisad:109"], "en": "Dattātreya, Hare Kṛṣṇa, and Unmattānandadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:110", "SA_GV05_ilx_ws_dattatreyopanisad:111"], "en": "\"O sky-clad sage, O child-demon, O ocean of knowledge! (1). Thus ends the Upaniṣad.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:112"], "en": "The meter is Anuṣṭubh.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:113"], "en": "Sadāśiva is the seer;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:114", "SA_GV05_ilx_ws_dattatreyopanisad:115"], "en": "Dattātreya is the deity. \"Dattātreya\" is at the heart; \"Hare Kṛṣṇa\" is at the head.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:116"], "en": "\"Unmattānanda\" is at the crest-lock;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:117"], "en": "\"Dāyakamuni\" is at the armor;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:118"], "en": "\"Digaṃbara\" is at the eyes.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:119", "SA_GV05_ilx_ws_dattatreyopanisad:120", "SA_GV05_ilx_ws_dattatreyopanisad:121"], "en": "Regarding the weapon-mantra \"piśācajñānasāgara,\" this Anuṣṭubh verse has been studied by me.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:122"], "en": "The faults of being born into a non-Brahminical lineage perish;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:123"], "en": "one becomes a benefactor of all and attains liberation.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:124"], "en": "\"He who knows thus\"—this is the Upaniṣad. || 1 ||", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:125"], "en": "Thus ends the first section. || 1 ||", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:126"], "en": "One should utter \"Oṃ.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:127"], "en": "Oṃ, salutations to the Blessed One Dattātreya,", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:128"], "en": "who is satisfied by mere remembrance and who wards off great fear.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:129", "SA_GV05_ilx_ws_dattatreyopanisad:130"], "en": "One should utter \"Oṃ\" to the bestower of great knowledge, whose nature is consciousness and bliss, who wears the guise of a child, a madman, or a ghost, the great yogin, the avadhūta, the increaser of Anasūyā’s joy, the son of Atri, the granter of the fruits of all desires,", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:131"], "en": "and the liberator from the bonds of worldly existence.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:132"], "en": "One should utter \"hrīṃ.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:133"], "en": "One should utter \"kroṃ,\" [meaning] \"to the giver of all prosperity.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:134"], "en": "One should utter \"sauri,\" [meaning] \"for the attraction of the object to be accomplished.\"", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:135"], "en": "One should utter \"Śrī\" for the purpose of agitating all minds;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:136"], "en": "one should utter \"Mahas\";", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:137"], "en": "and one should utter \"Vaṣaṭ\" for the long-lived one.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:138", "SA_GV05_ilx_ws_dattatreyopanisad:139"], "en": "One should utter: \"Vaśīkuru vaśīkuru vauṣaṭ!", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:140"], "en": "and \"Ākarṣaya ākarṣaya hūṃ!\"", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:141", "SA_GV05_ilx_ws_dattatreyopanisad:142"], "en": "One should utter: \"vidveṣaya vidveṣaya phaṭ. One should utter:", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:143"], "en": "\"uccāṭaya uccāṭaya ṭhaṭha.\"", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:144", "SA_GV05_ilx_ws_dattatreyopanisad:145", "SA_GV05_ilx_ws_dattatreyopanisad:146"], "en": "\"Stambhaya stambhaya khakhāhā! he should utter; \"Māraya māraya namaḥ!\"", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:147"], "en": "Homage to the Accomplished One! Svāhā to the Accomplished One! Nourish, nourish!", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:148"], "en": "Cut asunder, cut asunder those bound by other mantras, other yantras, and other dependencies!", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:149"], "en": "Ward off, ward off the seizing spirits! Ward off, ward off diseases! [Ward off] suffering!", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:150"], "en": "\"O Hara, O Hara! Drive away, drive away poverty! Sustain, sustain the body!", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:151", "SA_GV05_ilx_ws_dattatreyopanisad:152"], "en": "Delight, delight the mind!\"—this is the nature of all mantras, all yantras, all tantras, and all pallavas; \"Oṃ, obeisance to Śiva\"—thus ends the Upaniṣad. || 2 ||", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:153"], "en": "Thus ends the second section. || 2 ||", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:154"], "en": "He who knows thus:", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:155"], "en": "the metre is Anuṣṭubh;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:156"], "en": "Sadāśiva is the seer.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:157"], "en": "Dattātreya is the deity;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:158"], "en": "\"Om\" is the seed-syllable;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:159"], "en": "\"Svāhā\" is the power.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:160"], "en": "\"Drām\" is the *kīlaka*.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:161"], "en": "There are eight mantras for the eight forms (*aṣṭamūrti*).", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:162"], "en": "He who recites this daily [is protected] by Vāyu, Agni, Soma, Āditya, Brahmā, Viṣṇu, and Rudra.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:163"], "en": "One becomes purified.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:164"], "en": "It is as if one hundred thousand recitations of the Gāyatrī have been performed.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:165"], "en": "One becomes a performer of one hundred thousand recitations of the Mahārudra.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:166"], "en": "It becomes as if ten million times ten thousand repetitions of the *praṇava* have been performed.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:167"], "en": "It purifies a hundred ancestors and a hundred descendants;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:168"], "en": "he becomes a sanctifier of the row.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:169"], "en": "One becomes liberated from sins such as the killing of a Brahmin;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:170"], "en": "one becomes liberated from sins such as the killing of a cow;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:171"], "en": "and by means of gifts such as the *tulāpuruṣa*, one becomes purified from the drinking of alcohol.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:172", "SA_GV05_ilx_ws_dattatreyopanisad:173"], "en": "One becomes liberated from all sins without exception; one becomes liberated from the sins of eating what is permissible and what is forbidden;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:174"], "en": "and one becomes a master of all mantra-yogas.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:175"], "en": "He alone becomes a true Brāhmaṇa;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:176"], "en": "therefore, one should accept a devoted disciple,", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:177"], "en": "for he enjoys infinite fruit.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:178"], "en": "\"He becomes liberated while living,\" thus spoke the Blessed Lord Nārāyaṇa to Brahmā; such is the Upaniṣad.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:179"], "en": "Oṃ! May we hear with our ears what is auspicious, O Gods; may we see with our eyes what is auspicious, O Holy Ones.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:180"], "en": "With steady limbs and bodies, may we, praising you, attain that lifespan ordained by the gods.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:181"], "en": "Oṃ! May Indra of far-reaching fame grant us well-being; may Pūṣan, the knower of all, grant us well-being;", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:182"], "en": "may Tārkṣya, whose wheel-rims are unharmed, grant us well-being; may Bṛhaspati bestow well-being upon us.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:183"], "en": "Oṃ, peace, peace, peace! Hariḥ oṃ, that is the truth.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"},
{"segs": ["SA_GV05_ilx_ws_dattatreyopanisad:184"], "en": "Thus ends the Dattātreyopaniṣad.", "model": "mitra-v4", "translated_at": "2026-11-25T15:12:32Z"}
]
