[
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:0", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:1", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:2"], "en": "# Kirfel, *Das Purāṇa Pañcalakṣaṇa* (Bonn 1927) # Group IIB # Column 2 of the Parallel-Recension Layout (Divergent Parallel Passages Only)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:3", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:4"], "en": "# Book Pages 44–135 # Constituted Text Only;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:5"], "en": "Critical Apparatus Removed ## Part 1. Primary and Secondary Creation | Chapter 1 (Vol. I. 3.1–38; Kūrma Purāṇa 4.6–66; Liṅga Purāṇa 70.3–66; Mārkaṇḍeya Purāṇa 45.29–73; Vāyu Purāṇa 4.5–92)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:6"], "en": "But the *bhūtādi*, undergoing transformation,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:7"], "en": "produced the subtle element of sound;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:8"], "en": "from that [arose] space, which is characterized by its hollow nature.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:9"], "en": "The definition of sound is [thus] augmented. || 32 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:20Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:10", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:11"], "en": "But Ākāśa, undergoing transformation, indeed produced the subtle element of touch. || 33 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:12", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:13"], "en": "Space, consisting of sound alone, enveloped the element of touch alone. || 34 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:14", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:15"], "en": "Furthermore, because they are indistinguishable due to being peaceful, terrible, or deluded,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:16"], "en": "this creation of the gross elements and subtle elements [proceeds].", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:17"], "en": "But it is to be understood as being mutually [dependent]. || 40 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:18", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:19", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:20"], "en": "These seven great-souled ones, indeed, by virtue of their mutual dependence, do not exist as a complete whole without coming together. || 53 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:21", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:22"], "en": "Having come together, those great-souled ones [attained their goal] through mutual reliance upon one another.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:23", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:24", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:25"], "en": "Arising at one and the same time like a bubble upon the water, that egg was produced from the subtle elements (viśeṣas).", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:26"], "en": "That vast one dwells within the waters.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:27", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:28"], "en": "He is Hiraṇyagarbha, who manifested within this egg as the four-faced one,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:29"], "en": "both at the time of creation and at the time of re-absorption.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:30"], "en": "The Knower of the Field is designated as Brahman. || 59 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:31"], "en": "## Section One: Primary Creation and Secondary Creation | Chapter Three (Bḍ. I. 5.1–141; Kū. 6.1–25; L. 70.115–195a; Vā.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:32", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:33"], "en": "6.1–79) \"We have heard that the waters are indeed called *nārāḥ* because they are the bodies (*tanavaḥ*).\"", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:34", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:35"], "en": "Because he lies within the waters, for that reason he is remembered as Nārāyaṇa. || 5 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:36", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:37"], "en": "Furthermore, many types of creations are recorded as being mutually distinct from one another. || 54 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:38", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:39"], "en": "Learn their names as they persist until the dissolution of all beings! || 58 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:40", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:41", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:42"], "en": "Water, fire, earth, wind, heaven, the quarters, the oceans, rivers, mountains, and trees; || 59 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:43"], "en": "All those who take pride in their station are remembered as being designated by the name \"Station\" (sthāna). || 61 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:44", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:45", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:46"], "en": "Having created another thousand pairs from his thighs, he then [created] yet another. (1.5.38)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:47"], "en": "Those who were here excessively dominated by rajas and tamas are remembered as the Aśīlas.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:48"], "en": "Furthermore, he created another thousand pairs from his feet. || 39 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:49"], "en": "Overwhelmed by darkness, they were all devoid of splendor and possessed little luster;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:50"], "en": "then indeed those living beings, born of pairs, began to rejoice.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:51"], "en": "Overcome by mutual desire, they proceeded to engage in sexual union;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:52"], "en": "from that time forth, it is said that the origin of pairs occurred in this kalpa. || 41 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:53"], "en": "Whatever monthly menstrual flow women normally experience occurred for them then [only once];", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:54"], "en": "therefore, they did not give birth even though they engaged in sexual intercourse. || 42 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:55", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:56", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:57"], "en": "At the end of their lifespan, those *kuṭakas* and *kuvikas*, desiring to die, give birth to pairs of offspring all at once; having produced their lineage, they then cast off their bodies. (43)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:58", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:59"], "en": "From that time forth, in this kalpa, there was indeed the appearance of pairs; for those progeny were born repeatedly through meditation and the mind alone. || 44 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:60"], "en": "The objects such as sound and so forth are pure, each possessing five characteristics;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:61", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:62"], "en": "such was the prior mental creation of Prajāpati. || 45 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:63"], "en": "Then, after a long time,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:64"], "en": "due to the reversal of those very [qualities],", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:65"], "en": "there arose a state consisting of passion and greed.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:66"], "en": "For at that time, it occurred quite unexpectedly. || 59 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:67", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:68"], "en": "That which occurs for women at the end of life is their menstrual flow;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:69"], "en": "at that time, indeed, it does not occur.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:70"], "en": "Furthermore, by the power of the pair. || 59 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:71", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:72"], "en": "Furthermore, their menstrual flow recurs month after month; then,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:73"], "en": "by that very same process, [it occurs].", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:74"], "en": "sexual intercourse takes place at that time. || 59 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:75", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:76"], "en": "Because they occur at that specific time, [the semen] enters them month after month;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:77"], "en": "for [otherwise], menstruation would occur out of season.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:78"], "en": "The birth from the womb occurred. || 60 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:79", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:80"], "en": "But through their reversal at that time,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:81"], "en": "all of them will then perish.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:82"], "en": "Those trees are designated as houses. || 61 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:83"], "en": "Then, when those [means] had vanished, they,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:84"], "en": "bewildered and with agitated senses,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:85"], "en": "longed for that accomplishment.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:86"], "en": "Then, those who were intent upon truth. || 61 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:87", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:88"], "en": "For them, those trees appeared, designated as houses,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:89"], "en": "with a height equal to half the height of their heads.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:90"], "en": "A city sloping toward the northeast. || 76 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:91"], "en": "The chinna-karṇa, the vikarṇa,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:92"], "en": "that which is shaped like a fan,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:93"], "en": "the circular, the vajra-shaped, and the long.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:94"], "en": "The city is not praised. || 77 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:95", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:96"], "en": "A city situated in the cardinal directions and endowed with four corners is indeed highly praised;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:97"], "en": "the first [type] consists of twenty-four [squares].", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:98"], "en": "The hands [should be] at most eight hundred. || 78 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:99", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:100"], "en": "In this regard, they praise the middle [size], which is free from being too short or too long;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:101"], "en": "that is eight hundred *kiṣkus*.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:102"], "en": "They say that this is the primary form of settlement. || 79 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:103", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:104"], "en": "A *kheṭa* has half the diameter of a city, and a village is half that size;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:105"], "en": "a *kheṭa* is one *yojana* from a city.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:106"], "en": "The village is half a yojana from the hamlet. || 80 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:107"], "en": "The maximum boundary is two krośas,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:108"], "en": "while the boundary of a field is four dhanus;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:109"], "en": "thereafter, there arose again for them—", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:110", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:111", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:112"], "en": "Passion and greed exist in every way; however, by the power of the Tretā Yuga, they are inevitably subject to their destined end. || 94 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:113", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:114"], "en": "Then, once again, passion and greed arose in them in every way,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:115"], "en": "due to the inevitable occurrence of that which was destined to happen.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:116"], "en": "But by the power of the Tretā Yuga, however, || 94 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:117", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:118"], "en": "The Lord Brahmā, however, assigned their respective duties and characteristics. || 108 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:119", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:120"], "en": "The Lord granted them places in other worlds as a reward for their spiritual perfection.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:121"], "en": "Section 1: Sarga and Pratisarga Chapter 7 (Bd. I. 9.1–92; Kū. 8.1–28; L. 70.260b–324; Vā. 10.1–67)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:122", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:123", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:124"], "en": "When, in this manner, those worlds created by Brahmā, the creator of the worlds, did not increase, O Bhūta.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:125"], "en": "The subjects, for some reason or other, || 1 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:126"], "en": "The ancestors and likewise Agni. || 28 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:127"], "en": "He gave Satī to Bhava,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:128", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:129"], "en": "Khyāti to Bhṛgu, and Saṃbhūti to Marīci.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:130"], "en": "He gave Smṛti to Aṅgiras. || 29 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:131", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:132"], "en": "O God, this is Mahādeva, the Puruṣa, possessing a splendor equal to the sun. || 64 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:133"], "en": "1. Section: Sarga and Pratisarga | Chapter 9 (Bd. I. 11.1–44, 12.1–53; Vā.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:134", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:135"], "en": "28.1–39, 29.1–49) He who is Uṣij, Agni, and Kavi is recognized as the Neṣṭṛ priest. || 73 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:136", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:137"], "en": "But the Acchāvāka is perceived in the place of Bhuvaḥ;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:138"], "en": "however, the eighth [measure] is eight cubits long.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:139"], "en": "They are proclaimed as the *mārjālīya* fires. || 74 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:140", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeIIB-col2_Kirfel_1927:141"], "en": "For those who are to be established as hearths (dhiṣṇya) are indeed to be arranged by means of the Soma sacrifice and the Aṣṭādaśarātra. || 75 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:21Z"}
]
