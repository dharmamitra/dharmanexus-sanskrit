[
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:0"], "en": "Oṃ, salutations to Śrī Rāma.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:1"], "en": "Oṃ, salutations to Rāmabhadra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:2"], "en": "Oṃ, salutations to Rāmacandra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:3"], "en": "Oṃ, homage to the Eternal One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:4"], "en": "Oṃ, homage to the Lotus-eyed One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:5"], "en": "Oṃ, homage to the Glorious One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:6", "SA_GK19_ilx_ws_sriramastottarasatanamavali:7"], "en": "Oṃ, salutations to the Lord of Kings. Oṃ, salutations to the Bull among the Raghus.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:8"], "en": "Oṃ, salutations to the Beloved of Jānakī.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:9"], "en": "Oṃ, homage to Jaitra. || 10 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:10", "SA_GK19_ilx_ws_sriramastottarasatanamavali:11"], "en": "Oṃ, homage to the Conqueror of Enemies. Oṃ, homage to Janārdana.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:12"], "en": "Oṃ, homage to the Beloved of Viśvāmitra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:13", "SA_GK19_ilx_ws_sriramastottarasatanamavali:14"], "en": "Oṃ, homage to the Tamed One! Oṃ, homage to Him who is intent upon providing refuge and protection!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:15"], "en": "Oṃ, homage to the Subduer of Vālin!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:16", "SA_GK19_ilx_ws_sriramastottarasatanamavali:17"], "en": "Oṃ, homage to Vāgmin. Oṃ, homage to Satyavāc.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:18"], "en": "Oṃ, homage to Satyavikrama.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:19"], "en": "Oṃ, salutation to Satyavrata. || 20 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:20"], "en": "Oṃ, homage to the bearer of vows!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:21"], "en": "Oṃ, homage to the one eternally resorted to by Hanuman!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:22"], "en": "Oṃ, homage to the descendant of Kausalya!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:23", "SA_GK19_ilx_ws_sriramastottarasatanamavali:24", "SA_GK19_ilx_ws_sriramastottarasatanamavali:25"], "en": "Oṃ, salutation to the destroyer of Khara. Oṃ, salutation to the expert slayer of Virādha. Oṃ, salutation to the protector of Vibhīṣaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:26", "SA_GK19_ilx_ws_sriramastottarasatanamavali:27"], "en": "Oṃ, homage to the one who shattered the bow of Hara. Oṃ, homage to the one who struck down Saptatāla.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:28"], "en": "Oṃ, homage to the one who took away the heads of the ten-necked Rāvaṇa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:29"], "en": "Oṃ, homage to the one who shatters the great pride of Jamadagni’s son. || 30 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:30"], "en": "Oṃ, salutation to the destroyer of Tāṭakā.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:31", "SA_GK19_ilx_ws_sriramastottarasatanamavali:32"], "en": "Oṃ, salutation to the essence of the Vedānta. Oṃ, salutation to the self of the Vedas.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:33"], "en": "Oṃ, homage to the medicine for the disease of existence.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:34", "SA_GK19_ilx_ws_sriramastottarasatanamavali:35"], "en": "Oṃ, homage to the slayer of Dūṣaṇa and Triśiras. Oṃ, homage to the one of three forms.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:36"], "en": "Oṃ, salutation to the one whose nature consists of the three qualities.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:37", "SA_GK19_ilx_ws_sriramastottarasatanamavali:38"], "en": "Oṃ, salutation to Trivikrama. Oṃ, salutation to the Self of the three worlds.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:39"], "en": "Oṃ, salutation to the one who proclaims meritorious conduct and fame. || 40 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:40", "SA_GK19_ilx_ws_sriramastottarasatanamavali:41", "SA_GK19_ilx_ws_sriramastottarasatanamavali:42"], "en": "Oṃ, homage to the protector of the three worlds! Oṃ, homage to the wielder of the bow! Oṃ, homage to the one who dwells in the Daṇḍaka forest!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:43", "SA_GK19_ilx_ws_sriramastottarasatanamavali:44", "SA_GK19_ilx_ws_sriramastottarasatanamavali:45"], "en": "Oṃ, salutations to the one who liberated Ahalyā from her curse. Oṃ, salutations to the one devoted to his father. Oṃ, salutations to the bestower of boons.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:46"], "en": "Oṃ, homage to the one who has conquered the senses.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:47", "SA_GK19_ilx_ws_sriramastottarasatanamavali:48"], "en": "Oṃ, homage to the one who has conquered anger. Oṃ, homage to the one who has conquered friends.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:49"], "en": "Oṃ, homage to the Teacher of the World. || 50 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:50"], "en": "Oṃ, homage to the one who destroys the hosts of bears and monkeys!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:51", "SA_GK19_ilx_ws_sriramastottarasatanamavali:52"], "en": "Oṃ, homage to the one who takes refuge at Citrakūṭa! Oṃ, homage to the one who grants the boon of protection to Jayanta!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:53"], "en": "Oṃ, homage to the one served by the son of Sumitrā.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:54", "SA_GK19_ilx_ws_sriramastottarasatanamavali:55"], "en": "Oṃ, homage to the primordial god of all gods. Oṃ, homage to the one who restored the dead monkey to life.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:56"], "en": "Oṃ, homage to the slayer of Māyāmārīca.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:57", "SA_GK19_ilx_ws_sriramastottarasatanamavali:58"], "en": "Oṃ, homage to Mahādeva. Oṃ, homage to Mahābhuja.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:59"], "en": "Oṃ, homage to the one praised by all the gods. || 60 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:60"], "en": "Oṃ, homage to the Gentle One.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:61"], "en": "Oṃ, homage to the Friend of Brahman.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:62"], "en": "Oṃ, homage to the One Praised by the Sages.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:63"], "en": "Oṃ, homage to the Great Yogin!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:64"], "en": "Oṃ, homage to Mahodara!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:65"], "en": "Oṃ, homage to the one who bestowed the desired kingdom upon Sugrīva!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:66", "SA_GK19_ilx_ws_sriramastottarasatanamavali:67"], "en": "Oṃ, homage to the one whose fruit exceeds all merit. Oṃ, homage to the one who destroys the flood of all that is remembered.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:68"], "en": "Oṃ, homage to the Primordial Person.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:69"], "en": "Oṃ, homage to the Supreme Person. || 70 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:70", "SA_GK19_ilx_ws_sriramastottarasatanamavali:71", "SA_GK19_ilx_ws_sriramastottarasatanamavali:72"], "en": "Oṃ, homage to the Great Being. Oṃ, homage to the Arising of Merit. Oṃ, homage to the Essence of Compassion.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:53Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:73", "SA_GK19_ilx_ws_sriramastottarasatanamavali:74", "SA_GK19_ilx_ws_sriramastottarasatanamavali:75"], "en": "Oṃ, homage to the Ancient Supreme Person. Oṃ, homage to the one with a smiling face. Oṃ, homage to the one who speaks in measured words.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:76"], "en": "Oṃ, homage to the one who speaks first.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:77", "SA_GK19_ilx_ws_sriramastottarasatanamavali:78"], "en": "Oṃ, homage to Rāghava. Oṃ, homage to the one profound with infinite qualities.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:79"], "en": "Oṃ, homage to the one whose supreme qualities are those of the noble and majestic hero (dhīrodātta). || 80 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:80"], "en": "Oṃ, homage to the one who displays illusory human conduct.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:81", "SA_GK19_ilx_ws_sriramastottarasatanamavali:82"], "en": "Oṃ, homage to the one worshipped by Mahādeva and others. Oṃ, homage to the builder of the bridge.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:83", "SA_GK19_ilx_ws_sriramastottarasatanamavali:84"], "en": "Oṃ, homage to the one who has conquered the ocean [of existence]. Oṃ, homage to the one who embodies all sacred fords.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:85"], "en": "Oṃ, homage to Hari.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:86", "SA_GK19_ilx_ws_sriramastottarasatanamavali:87"], "en": "Oṃ, homage to the dark-bodied one. Oṃ, homage to the beautiful one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:88"], "en": "Oṃ, homage to the heroic one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:89"], "en": "Oṃ, homage to the one clad in yellow garments. || 90 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:90"], "en": "Oṃ, homage to the wielder of the bow.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:91", "SA_GK19_ilx_ws_sriramastottarasatanamavali:92"], "en": "Oṃ, homage to the lord of all sacrifices. Oṃ, homage to the sacrificer.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:93"], "en": "Oṃ, homage to the one free from old age and death.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:94"], "en": "Oṃ, homage to the establisher of the Śiva-liṅga.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:95"], "en": "Oṃ, homage to the one devoid of all defects.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:96", "SA_GK19_ilx_ws_sriramastottarasatanamavali:97"], "en": "Oṃ, salutation to the Supreme Self. Oṃ, salutation to the Supreme Brahman.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:98"], "en": "Oṃ, salutation to the embodiment of existence, consciousness, and bliss.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:99"], "en": "Oṃ, salutation to the Supreme Light. 100.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:100", "SA_GK19_ilx_ws_sriramastottarasatanamavali:101"], "en": "Oṃ, salutation to the supreme abode. Oṃ, salutation to the supreme ether.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:102"], "en": "Oṃ, salutation to that which is higher than the high.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:103"], "en": "Oṃ, homage to the Supreme Lord!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:104", "SA_GK19_ilx_ws_sriramastottarasatanamavali:105"], "en": "Oṃ, homage to the one who has gone to the further shore! Oṃ, homage to the Further Shore!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:106", "SA_GK19_ilx_ws_sriramastottarasatanamavali:107"], "en": "Oṃ, salutation to the one whose essence is all the gods. Oṃ, salutation to the Supreme. 108.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"},
{"segs": ["SA_GK19_ilx_ws_sriramastottarasatanamavali:108"], "en": "Thus ends the glorious hymn of the one hundred and eight names of Rāma.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:54Z"}
]
