[
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':0"], "en": "Homage to Śākyasiṃha!", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':1", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':2"], "en": "I bow with devotion to the glorious Śākyasiṃha, the son of Śuddhodana, who shone forth at the seat of enlightenment;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':3"], "en": "he brought about his birth for the sake of perfect awakening.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':4"], "en": "From the armpit of Māyā, for the benefit of the world. || 1 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':5", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':6"], "en": "There was a king named Śrīsaṃmata who, for the sake of the world, established the distinctions of the social classes and so forth;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':7"], "en": "O Nami, I bow to you who are naturally free from such worldly conduct.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':8"], "en": "[He saw him] departing from the world-sphere known as Ābhāsvara. || 2 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':9", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':10"], "en": "Bṛhaddyuti, the potter, having respectfully given the finest food along with beans to the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':11"], "en": "[attained] what?", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':12", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':13"], "en": "Having resolved to attain such a state, he made this vow in his heart: \"I bow my head [to him].\"", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':14"], "en": "With joy,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':15", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':16"], "en": "King Dānādirāma gave a lump of boiled grain to the members of the Saugata community, and he became their servant.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':17"], "en": "I perpetually bow to my own former birth. || 4 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':18"], "en": "The king named Suprabha,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':19"], "en": "having correctly observed the intoxicated Matanga,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':20"], "en": "set his mind upon the attainment of perfect enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':21"], "en": "I perpetually bow to those who have abandoned desire.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':22", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':23"], "en": "Seeing those mortals oppressed by great diseases, the compassionate one, having abandoned the splendor of the king of the gods,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':24"], "en": "took upon himself the state of an animal.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':25"], "en": "I bow to him who has constantly protected you. || 6 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':26", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':27"], "en": "Samudrareṇu, immeasurable as the end of an eon, beholding the lowest age devoid of Jinas,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':28"], "en": "may I arise in the Kali age for the benefit of the world.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':29"], "en": "I bow to him who possesses such perfect resolve. || 7 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':30", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':31"], "en": "Having bestowed his divine vision upon those with fleshly eyes, he attained the unsurpassed Vidyādhara state;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':32"], "en": "by the power of his merit, he became a king named Puṇyabala.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':33"], "en": "I constantly bow to him who is terrifying to those seeking objects of fear. || 8 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':34"], "en": "King Pradīpapradyota,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':35", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':36"], "en": "being skilled in subduing the night and its passion, protected the caravans by raising his hand aloft.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':37"], "en": "I constantly bow down to the one who brings forth progeny. || 9 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':38", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':39"], "en": "The merchant Susiddhārthamati, who had brought back the king of jewels from the ocean of treasures,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':40"], "en": "protected those men who were impoverished.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':41"], "en": "I constantly bow with devotion to the Lord of Sages. || 10 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':42", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':43"], "en": "That king, having offered all his bodily limbs with devotion,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':44"], "en": "remained in the cremation ground for a thousand years.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':45"], "en": "Having forever uprooted the wicked, I bow down. || 11 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':46", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':47", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':48"], "en": "By that Naga dwelling in Patala, ten billion treasures of Jyotirasas gems were revealed upon the earth.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':49"], "en": "I perpetually bow down to that Lord of Serpents. || 12 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':50"], "en": "Having abandoned his home for the sake of those seeking merit,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':51"], "en": "and having left his own body in the forest,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':52"], "en": "he rescued the tigress and brought happiness to the world.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':53"], "en": "I bow to the one dwelling in the womb who goes to Nirvana. || 13 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':54", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':55"], "en": "Beholding an aged twice-born man born blind, he restored his eyesight and made Indra,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':56"], "en": "the assembly of ministers, and the world look on in wonder.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':57"], "en": "I bow to you, who are the manifestation of the five eyes. || 14 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':58", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':59"], "en": "The king named Sarvaprada, who, having abandoned his own kingdom and dwelt in a forest of asceticism,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':60"], "en": "gave away his own body and performed [this deed].", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':61"], "en": "I perpetually bow to the Brahmin who is rich in wealth. || 15 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':62", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':63"], "en": "The king named Maitrībala himself cut his own veins and offered them to the hosts of yakṣas;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':64"], "en": "he also fed them with his blood and flesh.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':65"], "en": "I bow constantly to that Lion of the Śākyas. || 16 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':66", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':67"], "en": "The prince named Viśvantara, a donor, having given away his lordly elephant, entered the forest;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':68"], "en": "he gave away his horses, chariot, sons, daughters, and wife.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':69"], "en": "I bow to him who always bestows gifts as a lord of charity. || 17 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':70"], "en": "The hare, a great lord of generosity,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':71"], "en": "who offered his own body to Śakra,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':72"], "en": "gave rise to that which is known by the name of the Moon.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':73"], "en": "I perpetually bow to Candra, the Lord of Sages. || 18 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':74", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':75"], "en": "With a mind intent on protecting the pigeon, he cut off his own flesh, placed it upon the scale,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':76"], "en": "and presented it, thereby causing Indra to be struck with amazement.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':77"], "en": "I perpetually bow down to the one who is always worthy of refuge. || 19 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':78", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':79"], "en": "The lord of men named Candraprabha, possessing the splendor of a thousand moons, gave his own hand,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':80"], "en": "resting upon a beautiful footstool, to the brahmin Raudrākṣa.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':81"], "en": "I perpetually bow down to that Lion of the Śākyas. || 20 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':82"], "en": "By the gift of a jewel, he became known as Maṇicūḍa; indeed,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':83", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':84"], "en": "through his generosity, he attained the further shore and became a king honored by all, whose auspicious residence was Śrīśrī.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':85"], "en": "I bow to the teacher of the entire world. || 21 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':86", "SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':87"], "en": "Whoever recites this hymn composed on earth shall not suffer from famine, poverty, or disease;", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':88"], "en": "he shall attain the destruction of fear from malevolent planets.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':89"], "en": "He is glorious, a donor, and the one who effects the non-destruction of all things from the beginning.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':90"], "en": "Having praised the compassionate Guru, the Lord of Sages,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':91"], "en": "and having circumambulated him three times,", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':92"], "en": "the Great Goddess Earth vanished from sight.", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':93"], "en": "Repeatedly remembering the sole Lord of the world. || 23 ||", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':94"], "en": "Thus ends the hymn to the illustrious Śākyasiṃha composed by Kṣmādevī in the glorious Jātakamālā. May there be auspiciousness!", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"},
{"segs": ["SA_T01_Kṣmādevī-Pṛthivī_Śākyasiṃhastotra-`in-the-Jātakamālā':95"], "en": "[For the following, see Śākyasiṃhastotra_Cūḍābhikṣuṇī.txt]", "model": "mitra-v4", "translated_at": "2026-11-25T17:52:10Z"}
