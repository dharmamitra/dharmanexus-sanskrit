[
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:0"], "en": "Oṃ, homage to the son of the Earth.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:1", "SA_GK19_ilx_ws_angarakastottarasatanamavali:2"], "en": "Oṃ, homage to the one of great fortune. Oṃ, homage to Maṅgala.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:3"], "en": "Oṃ, homage to the Bestower of Auspiciousness.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:4", "SA_GK19_ilx_ws_angarakastottarasatanamavali:5"], "en": "Oṃ, homage to the Great Hero. Oṃ, homage to the Great Warrior.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:6", "SA_GK19_ilx_ws_angarakastottarasatanamavali:7"], "en": "Oṃ, homage to the one of great strength and prowess! Oṃ, homage to the Great Fierce One!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:8"], "en": "Oṃ, homage to the Great Auspicious One!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:9"], "en": "Oṃ, homage to the venerable one. || 10 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:10", "SA_GK19_ilx_ws_angarakastottarasatanamavali:11"], "en": "Oṃ, homage to Dayākarāya! Oṃ, homage to Mānadāya!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:12"], "en": "Oṃ, homage to Amarṣaṇāya!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:13", "SA_GK19_ilx_ws_angarakastottarasatanamavali:14"], "en": "Oṃ, homage to the Fierce One. Oṃ, homage to the One Free from Heat and Sin.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:15"], "en": "Oṃ, homage to the One with Beautiful Limbs.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:16"], "en": "Oṃ, homage to Sutāmrākṣa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:17", "SA_GK19_ilx_ws_angarakastottarasatanamavali:18"], "en": "Oṃ, homage to Subrahmaṇya. Oṃ, homage to Sukhaprada.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:19"], "en": "Oṃ, salutation to the one who goes to Vakrastambha and other [places]. || 20 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:20"], "en": "Oṃ, homage to the most excellent one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:21", "SA_GK19_ilx_ws_angarakastottarasatanamavali:22"], "en": "Oṃ, homage to the giver of boons. Oṃ, homage to the blissful one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:23"], "en": "Oṃ, homage to Vīrabhadra.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:24"], "en": "Oṃ, homage to Virūpākṣa.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:25"], "en": "Oṃ, homage to Vidūrastha.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:26"], "en": "Oṃ, homage to Vibhāvasu.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:27", "SA_GK19_ilx_ws_angarakastottarasatanamavali:28"], "en": "Oṃ, homage to the one who moves through the circle of the lunar mansions. Oṃ, homage to the one whose form is the lunar mansions.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:29"], "en": "Oṃ, salutation to the one who is devoid of the warrior class. || 30 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:30"], "en": "Oṃ, homage to the one who is liberated from decay and increase.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:31"], "en": "Oṃ, homage to the far-sighted one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:32"], "en": "Oṃ, homage to the one who bestows inexhaustible fruit.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:33"], "en": "Oṃ, homage to the one whose range is the field of vision.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:34", "SA_GK19_ilx_ws_angarakastottarasatanamavali:35"], "en": "Oṃ, homage to the one endowed with auspicious marks. Oṃ, homage to the one free from passion.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:36", "SA_GK19_ilx_ws_angarakastottarasatanamavali:37"], "en": "Oṃ, homage to the one free from fear. Oṃ, homage to the one free from fever.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:38"], "en": "Oṃ, homage to the cause of the universe.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:39"], "en": "Oṃ, homage to the movement through the constellations and zodiacal signs. || 40 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:40"], "en": "Oṃ, homage to the one who cuts through various fears!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:41", "SA_GK19_ilx_ws_angarakastottarasatanamavali:42"], "en": "Oṃ, homage to the one who is desirable! Oṃ, homage to the one whose essence is compassion!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:43"], "en": "Oṃ, homage to the one adorned with shimmering golden ornaments!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:44"], "en": "Oṃ, homage to the destroyer of fear!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:45"], "en": "Oṃ, homage to the bestower of auspicious fruits!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:46"], "en": "Oṃ, homage to the one who bestows fearlessness and boons upon his devotees.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:47", "SA_GK19_ilx_ws_angarakastottarasatanamavali:48"], "en": "Oṃ, homage to the slayer of enemies. Oṃ, homage to the one endowed with tranquility.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:49"], "en": "Oṃ, homage to the protector of those who have come for refuge. || 50 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:50"], "en": "Oṃ, homage to the courageous one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:51"], "en": "Oṃ, homage to the overseer of virtuous qualities.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:52"], "en": "Oṃ, homage to the righteous one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:53", "SA_GK19_ilx_ws_angarakastottarasatanamavali:54", "SA_GK19_ilx_ws_angarakastottarasatanamavali:55"], "en": "Oṃ, homage to the one invincible in battle! Oṃ, homage to the one who keeps the wicked at a distance! Oṃ, homage to the one worthy of worship by the virtuous!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:56", "SA_GK19_ilx_ws_angarakastottarasatanamavali:57"], "en": "Oṃ, homage to the one who wards off all misfortune! Oṃ, homage to the one who obstructs evil conduct!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:58"], "en": "Oṃ, homage to the one who shatters suffering!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:59"], "en": "Oṃ, homage to Durdhara. || 60 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:60", "SA_GK19_ilx_ws_angarakastottarasatanamavali:61", "SA_GK19_ilx_ws_angarakastottarasatanamavali:62"], "en": "Oṃ, salutation to Hari. Oṃ, salutation to the destroyer of evil dreams. Oṃ, salutation to the invincible one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:63"], "en": "Oṃ, homage to the one who liberates from wicked pride!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:64"], "en": "Oṃ, homage to the one born of the Bharadvāja lineage!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:65"], "en": "Oṃ, homage to the son of the Earth!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:66"], "en": "Oṃ, homage to the ornament of the worthy.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:67", "SA_GK19_ilx_ws_angarakastottarasatanamavali:68"], "en": "Oṃ, homage to the one clad in red garments. Oṃ, homage to the one with a red body.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:69"], "en": "Oṃ, salutations to the one intent upon protecting his devotees. || 70 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:70", "SA_GK19_ilx_ws_angarakastottarasatanamavali:71", "SA_GK19_ilx_ws_angarakastottarasatanamavali:72"], "en": "Oṃ, homage to the four-armed one. Oṃ, homage to the wielder of the mace. Oṃ, homage to the one whose vehicle is a ram.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:73", "SA_GK19_ilx_ws_angarakastottarasatanamavali:74", "SA_GK19_ilx_ws_angarakastottarasatanamavali:75"], "en": "Oṃ, homage to Mitāśana. Oṃ, homage to the wielder of the spear and trident. Oṃ, homage to Śakta.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:76", "SA_GK19_ilx_ws_angarakastottarasatanamavali:77"], "en": "Oṃ, homage to the one skilled in the science of weapons. Oṃ, homage to the dialectician.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:78"], "en": "Oṃ, homage to the support of darkness.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:79"], "en": "Oṃ, homage to the ascetic. || 80 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:80"], "en": "Oṃ, homage to the one with copper-colored eyes.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:81", "SA_GK19_ilx_ws_angarakastottarasatanamavali:82"], "en": "Oṃ, homage to the one who resembles molten gold. Oṃ, homage to the one who resembles red saffron filaments.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:83", "SA_GK19_ilx_ws_angarakastottarasatanamavali:84"], "en": "Oṃ, homage to the deity presiding over the lineage. Oṃ, homage to the one who moves in the midst of the cows.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:85"], "en": "Oṃ, homage to the one adorned with virtues.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:86"], "en": "Oṃ, homage to Asṛj.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:87"], "en": "Oṃ, homage to Aṅgāraka.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:88"], "en": "Oṃ, homage to the sovereign of the land of Avanti.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:89"], "en": "Oṃ, homage to Janārdana. || 90 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:90"], "en": "Oṃ, homage to the one situated in the solar southern region.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:91", "SA_GK19_ilx_ws_angarakastottarasatanamavali:92"], "en": "Oṃ, homage to youth. Oṃ, homage to the one whose face is turned toward the southern direction.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:93"], "en": "Oṃ, homage to the one situated within the triangular maṇḍala.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:94"], "en": "Oṃ, homage to the one praised by the lords of the thirty-three gods.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:95"], "en": "Oṃ, homage to the pure one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:96"], "en": "Oṃ, homage to the Purifier!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:97"], "en": "Oṃ, homage to the Hero!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:98"], "en": "Oṃ, homage to the One Subdued by Purity!", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:99"], "en": "Oṃ, homage to the one who brings about auspiciousness. || 100 ||", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:100"], "en": "Oṃ, homage to the lord of the zodiac signs Aries and Scorpio.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:101"], "en": "Oṃ, homage to the wise one.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:102"], "en": "Oṃ, homage to the one who speaks with moderation.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:103", "SA_GK19_ilx_ws_angarakastottarasatanamavali:104", "SA_GK19_ilx_ws_angarakastottarasatanamavali:105"], "en": "Oṃ, homage to the Bestower of Happiness. Oṃ, homage to the One with Beautiful Eyes. Oṃ, homage to the Bestower of the Fruit of All Desires.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:106"], "en": "Oṃ, salutation to the illustrious Aṅgāraka.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"},
{"segs": ["SA_GK19_ilx_ws_angarakastottarasatanamavali:107"], "en": "Thus ends the list of one hundred and eight names of Aṅgāraka.", "model": "mitra-v4", "translated_at": "2026-11-25T05:48:58Z"}
]
