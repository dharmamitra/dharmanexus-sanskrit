{"segs": ["SA_GSP31_tttvsamu:101"], "en": "Bondage is of three kinds (Tattvasaṃhitā 2.12).", "model": "mitra-v4", "translated_at": "2026-11-25T12:31:52Z"},
{"segs": ["SA_GSP31_tttvsamu:102"], "en": "Liberation is threefold (Tats_2.13).", "model": "mitra-v4", "translated_at": "2026-11-25T12:31:52Z"},
