{"segs": ["SA_GK19_ilx_ws_adityanamavalih:127", "SA_GK19_ilx_ws_adityanamavalih:128", "SA_GK19_ilx_ws_adityanamavalih:129"], "en": "Oṃ, salutation to the witness of the world. Oṃ, salutation to the creator of beings. Oṃ, salutation to the protector of beings.", "model": "mitra-v4", "translated_at": "2026-11-25T05:47:15Z"},
{"segs": ["SA_GK19_ilx_ws_adityanamavalih:130"], "en": "Oṃ, obeisance to the destroyer of spirits.", "model": "mitra-v4", "translated_at": "2026-11-25T05:47:15Z"},
{"segs": ["SA_GK19_ilx_ws_adityanamavalih:131", "SA_GK19_ilx_ws_adityanamavalih:132"], "en": "130. Oṃ, obeisance to Pāyata. Oṃ, obeisance to Tapata.", "model": "mitra-v4", "translated_at": "2026-11-25T05:47:15Z"},
{"segs": ["SA_GK19_ilx_ws_adityanamavalih:133", "SA_GK19_ilx_ws_adityanamavalih:134", "SA_GK19_ilx_ws_adityanamavalih:135"], "en": "Oṃ, salutation to the one who rains down; Oṃ, salutation to the one who is awake among those who sleep; Oṃ, salutation to the one who is firmly established among all beings. 135.", "model": "mitra-v4", "translated_at": "2026-11-25T05:47:15Z"},
{"segs": ["SA_GK19_ilx_ws_adityanamavalih:136", "SA_GK19_ilx_ws_adityanamavalih:137"], "en": "Oṃ, salutation to Agnihotra. Oṃ, salutation to the fruit of those who maintain the sacred fire.", "model": "mitra-v4", "translated_at": "2026-11-25T05:47:15Z"},
{"segs": ["SA_GK19_ilx_ws_adityanamavalih:138"], "en": "Oṃ, salutation to the Supreme Brahman, the most capable. 138.", "model": "mitra-v4", "translated_at": "2026-11-25T05:47:15Z"}
