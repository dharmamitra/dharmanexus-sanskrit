[
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:0", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:1"], "en": "Kirfel, *Das Purāṇa Pañcalakṣaṇa* (Bonn 1927). Text Group II.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:2"], "en": "Column 2 of the parallel-recension layout (only divergent parallel passages).", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:3", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:4", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:5"], "en": "# Book pages 153–471 # Constituted Text Only; Critical Apparatus Removed ## Section 2. Vaṃśa | Chapter 2 | C. (Mt. 7.1–65; P. I. 7.1–66; P.2 V. 7.1–66.)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:6"], "en": "In the month of Jyeṣṭha, during the bright fortnight,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:7"], "en": "on the full moon day,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:8"], "en": "one who has observed the vow should place a flawless jar filled with white rice.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:9", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:10"], "en": "Likewise, it should be provided with various fruits and accompanied by stalks of sugarcane, covered with a pair of white cloths, and anointed with white sandalwood paste. || 11 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:11", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:12"], "en": "One should place a copper vessel filled with various kinds of food and accompanied by gold according to one's means, together with jaggery, upon it.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:13", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:14"], "en": "Above that, one should fashion Brahmā within the hollow of a golden lotus,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:15"], "en": "provided with sugar.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:16"], "en": "Sāvitrī is on his left side. || 13 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:17"], "en": "One should offer perfumes and incense to the two [deities], and cause songs and instrumental music to be performed;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:18", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:19"], "en": "in their absence, one should tell a story, as the Grandfather did for Padma. || 14 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:20", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:21"], "en": "And having fashioned an auspicious image named Brahman made of molasses,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:22"], "en": "[one should worship it] with white flowers, unbroken rice, and sesame seeds.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:23"], "en": "One should worship Padmasambhava. || 15 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:24", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:25", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:26"], "en": "Having worshipped the feet with the mantra for Brahmā, the shanks with that for the Giver of Good Fortune (Saubhāgyadā), and the pair of thighs with that for Viriñci;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:27"], "en": "\"To Manmatha,\" indeed, [he offers] the waist. || 16 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:28"], "en": "\"To Svacchodara\" for the belly; \"to Ananga\" for the chest of Hari;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:29"], "en": "\"to Padmamukha\" for the face; and indeed \"to Pañcaśara\" for the arms.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:30"], "en": "\"Salutation to the Soul of All\"—with these words, one should worship Keśava on the crown [of the head].", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:31"], "en": "Then, at dawn, one should present that water-pot to a Brāhmaṇa. || 18 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:32"], "en": "One should feed the Brahmins with devotion, while one eats oneself without salt;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:33"], "en": "with devotion one should give a sacrificial fee (dakṣiṇā) and recite this mantra: || 19 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:34", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:35"], "en": "May the Blessed One, the Grandfather of all the worlds, be pleased with this;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:36"], "en": "may bliss be proclaimed. || 20 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:37"], "en": "By this procedure, one should perform everything as prescribed month after month;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:38", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:39"], "en": "fasting on the full moon day, one should worship the imperishable Brahman. || 21 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:40"], "en": "One should sleep on the bare ground;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:41"], "en": "then, in the thirteenth month, [one should give] a cow accompanied by clarified butter. || 22 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:42", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:43"], "en": "One should give a bed, complete with all its furnishings, to Viriñca,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:44"], "en": "having fashioned Brahmā out of gold.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:45"], "en": "Likewise, Sāvitrī and Rājatī. || 23 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:46"], "en": "The lotus-natured Creator,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:47"], "en": "having obtained Sāvitrī,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:48"], "en": "[honored] the twice-born man together with his wife with garments.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:49"], "en": "Having worshipped [him] according to one's capacity with ornaments, || 24 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:50"], "en": "One should give cows and other gifts according to one's capacity,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:51", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:52"], "en": "uttering the words \"May [the deity] be pleased,\" and perform a fire offering with white sesame seeds.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:53"], "en": "One should recite the names of Brahman. || 25 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:54", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:55", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:56"], "en": "Likewise, the knower of dharma should give food to the Brahmins with cow's ghee and milk-rice, avoiding any stinginess regarding his wealth; furthermore, he should give stalks of sugarcane and flower garlands according to his ability. || 26 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:57", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:58", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:59"], "en": "Whoever performs this Madanadvādaśī according to this rite shall be liberated from all sins.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:60"], "en": "One attains identity with Hari. || 27 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:61"], "en": "He who is remembered as Brahmā is Viṣṇu;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:62"], "en": "he is the blissful self, Maheśvara. || 28 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:63", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:64"], "en": "Seeking happiness, one should meditate upon the Grandfather God in whatever form one desires;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:65"], "en": "thereafter, I shall bring about conception.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:66", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:67", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:68"], "en": "\"O auspicious goddess, once I have touched your breasts, you shall indeed conceive a child who will be the slayer of Indra. || 33 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:69", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:70"], "en": "One should never say, \"I have been treated by you in such a manner. || 46 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:71"], "en": "Then, having heard her husband’s words,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:72"], "en": "she performed [the rite] according to the prescribed rule.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:73"], "en": "Thereupon, Indra also became afraid and approached the side of Diti.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:30Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:74"], "en": "Having left the abode of the gods, he remained there, desiring to serve her. || 48 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:75"], "en": "Indra, the subduer of Paka, became intent on seeking a vulnerability within Diti;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:76", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:77"], "en": "outwardly he was cheerful-faced and composed, yet inwardly he was restless. || 49 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:78"], "en": "Not knowing that it was his own duty, he performed a meritorious act;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:79"], "en": "thus, at the end of a hundred years, with three days still remaining, [she died]. (50)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:80"], "en": "With a mind filled with wonder and joy, she considered herself to have achieved her purpose;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:81"], "en": "without washing her feet, she lay down with her hair disheveled.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:82"], "en": "In one place, overcome by the weight of sleep, she lay with her head toward the west during the day;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:83"], "en": "then, finding that opportunity, the husband of Śacī entered within.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:84"], "en": "The lord of the thirty gods split that embryo into seven parts with his vajra;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:85"], "en": "from it were born seven kumāras, possessing the brilliance of the sun. || 53 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:86"], "en": "Those seven boys were crying, but they were forbidden by the Enemy of the Dānavas;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:87"], "en": "as they continued to cry, Hari [seized] each one of them seven times over.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:88"], "en": "The slayer of Vṛtra indeed cut them again as they stood in a row;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:89"], "en": "thus becoming forty-nine, they wept bitterly. || 55 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:90"], "en": "Indra restrained them, saying: \"Do not weep again and again;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:91", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:92"], "en": "for by the power of merit, you shall obtain this very fruit of the full-moon festival. (57)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:93", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:94"], "en": "Surely this has come to fruition, or perhaps it is due to the worship of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:95"], "en": "Section 2: Genealogy Chapter 4 (Mt. 10.1–35; P.1 I. 8.1–35; P.2 V. 8.1–35a)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:96", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:97"], "en": "The milker was named Vasuruci,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:98"], "en": "who had reached the further shore of the Atharvaveda.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:99", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:100", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:101"], "en": "\"What shall I do? he spoke to her as she stood before him.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:102", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:103"], "en": "Out of dispassion, at the sacred site of Puṣkara, he subsisted on fruits, foam, and air.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:104", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:105"], "en": "Having propitiated his grandfather once again for ten thousand years,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:106"], "en": "the Lord of the Gods [was pleased] by the power of his asceticism.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:107"], "en": "Padmasambhava was contented. || 19 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:108"], "en": "He went from Padmasambhava.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:109"], "en": "Section 4: The Genealogy. Chapter 2 (Mt. 11.40–12.57; P.1 I. 8.75b–163; P.2 V. 8.75–162; cf. Kū. 20.19–25, 21.1–61; L. 65.22–39, 66.14–42).", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:110"], "en": "He went forth once more for ascetic penance.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:111", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:112", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:113"], "en": "Then, for the sake of attaining perfection, Ila departed from the Puṣkara penance grove and set out across this earth.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:114", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:115", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:116"], "en": "He suddenly attained womanhood and became a mare in an instant; everything that had been done in his state as a man was thus reversed.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:117"], "en": "Then, it was forgotten within the female body. || 9 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:118"], "en": "Having performed the horse sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:119"], "en": "Ilā then became Kimpuruṣa.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:120"], "en": "## Section 4. Vaṃśānucarita | Chapter 3 | Part A. (Mt. 23.1–47; P.1 I. 12.1–42; P.2 V. 12.1–51.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:121", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:122"], "en": "O you who are proficient in all the scriptures, how did the Lunar Dynasty (Somavaṃśa) originate?", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:123"], "en": "Who, indeed, were the kings in that lineage who increased their fame? || 1 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:124"], "en": "Sūta (Pulastya said):", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:125"], "en": "Long ago, at the beginning of creation, Atri was commanded by Brahmā;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:126"], "en": "that lord then performed a supreme austerity for the purpose of procreation. || 2 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:127", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:128"], "en": "That Brahman which brings bliss, which destroys the afflictions of the world, and which lies beyond the senses within the interior of Brahmā, Viṣṇu, Arka, and Rudra; || 3 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:129", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:130"], "en": "Having established peace in his mind, Atri then remained fixed in self-restraint,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:131"], "en": "whether through the greatness of his spiritual power or his asceticism.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:132"], "en": "It is that which produces supreme bliss. || 4 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:133"], "en": "Because the Lord of the Lineage,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:134", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:135"], "en": "together with [the assembly], presided over that at the proper time, having seen it being performed by one who was striving;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:136"], "en": "Therefore, Soma became all-pervading. || 5 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:137", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:138"], "en": "Then, from his two eyes, there flowed water born of Atri,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:139"], "en": "illuminating the entire universe, including all things mobile and immobile, with its moonlight.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:140"], "en": "The quarters of the sky seized that [seed] there in the form of a drop, desiring to drink it;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:141"], "en": "it became an embryo within their bellies,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:142"], "en": "having originated from Atri.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:143", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:144"], "en": "This auspicious mandala is the abode of the Vedas and its essence;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:145"], "en": "[this is for one] who has thus committed an offense.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:146", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:147", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:148"], "en": "At that time, their group of husbands was unable to cause them harm through curses, weapons, or other means. || 27 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:149"], "en": "Nevertheless, the Moon shone forth, illuminating the ten directions;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:150"], "en": "having attained that sovereignty which is difficult to reach and bestowed by the sages.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:151"], "en": "Section 4: Genealogy of the Lineage | Chapter 3 | Part B (Mt. 24.1–71; Mh. I. 3156b–3182; P.1 I. 12.43–98a; P.2 V. 12.52–109)", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:152", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:153"], "en": "The Daityas, Keśin and others, entered his service;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:154"], "en": "by the grace of Brahmā, Devendra [attained his sovereignty].", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:155"], "en": "Then he gave him half of his own seat. || 14 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:156", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:157", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:158"], "en": "Seeing him slain by him [Prasena], and not relinquishing that Syamantaka jewel, [Akrūra took it].", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:159", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:160"], "en": "Then that powerful king of bears made a sound as before;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:161"], "en": "and he beheld Viṣṇu in that manner.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:162", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:163", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:164"], "en": "The King of Bears also quickly praised the body of Viṣṇu with his various deeds by means of the Viṣṇusūkta.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:165", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:166"], "en": "Then the Blessed One, being pleased, was inclined to grant a boon. || 11 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:167", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:168"], "en": "Then he indeed gave that jewel-gem to Satrājit,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:169"], "en": "which had been obtained from the king of the bears.", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:170"], "en": "In the assembly of all the Yādavas. || 15 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:171", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:172"], "en": "She gave birth to sons of great strength and prowess. || 19 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:173", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:174"], "en": "Satyabhāmā, the best among women, observant of vows and firm in her resolve, as well as Padmāvatī—these he gave to Kṛṣṇa. || 19 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:175"], "en": "## Section 4. Vaṃśānucarita | Chapter 4 (Mt. 45.22–33, 44.61–85, 46.1–29; P.1 I. 13.96b–106a; 44b–69; 107b–134; P.2 V. 13.97b–107a; 45b–72a; 108b–138).", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:176", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:177"], "en": "The three sons of Samauja were renowned as being supremely righteous:", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:178", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:179"], "en": "Śrutadevī bore to Vṛddha a king named Kārūṣa;", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:180"], "en": "and from Kaikeyī, Śrutakīrti, was born King Saṃtardana. || 42 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:181"], "en": "To Śrutaśravas, the king of Cedi, was born Sunitha,", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:182", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:183"], "en": "who was a great practitioner of dharma and a subduer of his enemies. || 43 ||", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:184", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:185", "SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:186"], "en": "| | |", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"},
{"segs": ["SA_GP12_anon_Purāṇapañcalakṣaṇa-TextgruppeII-col2_Kirfel_1927:187"], "en": "[Translation] [Text to be translated] [Output] [Translated Text]", "model": "mitra-v4", "translated_at": "2026-11-25T06:31:31Z"}
]
