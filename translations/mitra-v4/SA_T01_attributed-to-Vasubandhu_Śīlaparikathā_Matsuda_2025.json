[
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:0", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:1", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:2"], "en": "% 1 = TDM 23.3.18 % 2 = 23.3.19 % 3 = 23.3.20", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:3", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:4", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:5"], "en": "% 4 = 23.3.22 % 5 = 17.1.13 % 6 = 17.1.15", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:6", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:7", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:8"], "en": "% 7 = 17.1.23 % 8 = 17.1.24 % 9 = 17.1.29", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:9", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:10", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:11"], "en": "Whatever is the distance between the ocean and a cow’s footprint; whatever is the distance between them.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:12"], "en": "For that is the interval between generosity and ethical discipline.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:13", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:14"], "en": "[1] One who might give gifts with a joyful mind for a hundred years is surpassed by one who guards ethical discipline for even a single day. [2]", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:15"], "en": "Even a butcher or a caṇḍāla can give gifts;", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:16"], "en": "however, ethical discipline cannot be maintained by just anyone.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:17"], "en": "Even one who is prosperous is not a great master of giving merely through the act of giving.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:18", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:19"], "en": "But by means of pure morality, one is considered a great lord of giving. Whether they wear the tonsure, or keep topknots,", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:20"], "en": "or carry matted locks drenched with the water of ritual bathing— let them be as they may.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:21"], "en": "Or let them wander, clothed in manifold conceptual constructions;", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:22"], "en": "this is merely a mockery if one is devoid of virtuous conduct.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:23"], "en": "Let them go to the Ganges, or let them approach the lakes.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:24"], "en": "Let him go to Sarasvatī or to the Puṣkara lakes;", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:25", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:26"], "en": "let him frequent Naimiṣa or go to Gayā—if his conduct is ruined, his labor is fruitless. [6]", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:27"], "en": "The fragrance of garlands does not spread in that way,", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:28", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:29"], "en": "nor does the scent of ointments; yet the supreme fragrance consisting of virtue wafts from the virtuous.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:30"], "en": "An imperishable fragrance wafts both in heaven and here on earth:", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:31"], "en": "contentment in this life, a fortunate rebirth hereafter,", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:32"], "en": "renown, popularity, and great honor.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:33", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:34"], "en": "The great seers know that this very happiness is indeed the abundant fruit of ethical discipline pertaining to the present life;", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:35"], "en": "for in times of illness, ethical discipline is the supreme medicine.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:36"], "en": "A protector in times of fear, a kinsman in times of calamity,", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:37", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:38"], "en": "a lamp in the darkness, a bridge over difficult terrain, and a raft in the great, bottomless waters of death. [9]", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:39", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:40"], "en": "The terror that enters one whose morality and discipline have fallen away at the time of destruction does not exist for the virtuous;", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:41"], "en": "therefore, with a joyful heart, [one should face] the next world at the end.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:42"], "en": "Whoever wishes to go [to that state], let him guard his very morality (śīla).", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:43"], "en": "By relying upon stainless and complete morality as it truly is,", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:44"], "en": "wisdom and the tranquility of mind reach full maturity.", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"},
{"segs": ["SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:45", "SA_T01_attributed-to-Vasubandhu_Śīlaparikathā_Matsuda_2025:46"], "en": "Therefore, whoever desires to attain liberation from the fear of old age, death, and disease, let them guard their ethical discipline alone. [11]", "model": "mitra-v4", "translated_at": "2026-11-25T19:04:47Z"}
]
